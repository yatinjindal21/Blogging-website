<% layout('layout/boilerplate') %>
   <link rel="stylesheet" href="/style/profile.css">
   <div class="container">
      <nav id="pnav">
         <ul>
            <li>></li>
            <li>@<%=userTable[0].username%>
            </li>
            <li><a href="/display-blogs">Edit</a></li>
         </ul>
      </nav>
      <header id="pheader">
         <img src="<%= userTable[0].pic ? `/uploads/${userTable[0].pic}` : '/uploads/defaultPfp.jpg' %>"  alt="profile">
         <div id="name">
            <%=userTable[0].name%>
         </div>
         <!-- <div id="followers">100 Followers | 100 Following | 20 Blogs</div> -->
         <div id="follow">
            <div>
               <center id="num">100<br></center>Followers
            </div>
            <div>
               <center id="num">200<br></center>Following
            </div>
            <div>
               <center id="num">300<br></center>Blogs
            </div>
         </div>
      </header>

      <main class="d-flex justify-content-center align-items-center">

         <div id="blogsBg">
            <%for(let blogs of blogTable){%>
               <div class="blogDiv" data-id="<%= blogs.blogid %>">
                  <div id="imgDiv">
                     <img src="/uploads/<%=blogs.image%>" id="blogImg" alt="Cropped Image">
                  </div>
                  <div class="text-truncate" id="titleDiv">
                     <%=blogs.blogname%>
                  </div>
               </div>
            <%}%>

         </div>
      </main>
   </div>
   <script>
      const blogs = document.querySelectorAll('.blogDiv');

      for (let blog of blogs) {
         blog.onclick = () => {
            const blogId = blog.getAttribute('data-id');
            window.location.href = `/view-blog/${blogId}`;
         }
      }



   </script>