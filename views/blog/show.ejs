<%layout('layout/boilerplate')%>
<link rel="stylesheet" href="/style/view-blog.css">


   <div id="box">
      <div id="title">
         <center>
            <span id="titletext">
               <%=blog.blogname%>
            </span>
         </center>
      </div>

      <div style="background-color: #c0a6982b;" id="imageblog">
         <center>
            <img class="img-fluid" id="images" src="/uploads/<%=blog.image%>" alt="">
         </center>
      </div>
      <!-- <div
      style="text-align: right; color:rgba(255, 255, 255, 0.68);font-size: small; font-weight: 500; ">
      20/04/23</div> -->
      <div id="content">
         <%=blog.blogcontent%>
            <div style="text-align: right;" id="author"><i>
                  <%=blog.name%>
               </i></div>
      </div>
      <div id="likesbox"><i class="bi bi-chat-heart"></i>
         <%=blog.likes%> <i class="bi bi-balloon-heart"></i> 40
      </div>
      <div id="userprofile"><img src="pics/anete-lusina-zwsHjakE_iI-unsplash.jpg" id="pfp"> <span style=" color: #ffffff;
         font-size: x-large;
         font-weight: 400; letter-spacing: 1px;">
            <%=blog.username%>
         </span></div>

      <!-- <div id="userprofile"><img src="pics/cornelius-ventures-Ak81Vc-kCf4-unsplash.jpg" id="pfp"> @ketaki</div> -->
   </div>
   <div style="width: 70%; margin: auto; position: relative; top:-1em;" id="comms">
      <form action="/view-blog/<%=blog.blogid%>/comment" method="post">
         <label for="comment"></label>
         <input type="text" id="comment" name="comment" placeholder="Comment Here">
         <button>Submit</button>
      </form>
   </div>