<%layout('layout/boilerplate')%>
   <link rel="stylesheet" href="style/display-blogs.css">

   <div class="container" ng-app="testModule">

      <input type="hidden" id="username" name="username">

      <div ng-controller="testController" ng-init="fetchBlogs();">
         <div class="card" ng-repeat="obj in jsonArray">
            <img src="uploads/{{obj.image}}" class="card-img-top" ng-click="redirect(obj.blogid);">
            <div class="card-body d-flex flex-column">
               <div class="text-truncate" id="card-title" name="card-title" ng-click="redirect(obj.blogid);"><b>{{obj.blogname}}</b></div>
               <div class="d-flex flex-row mt-auto">
                  <div class="me-auto">
                     <i class="fa-heart fa-xl" id="likebtn"
                        ng-class="{'fa-solid': obj.isLiked,'fa-regular': !obj.isLiked}"
                        ng-click="dolike(obj.blogid,$event);"></i>
                     <span id="likes" style="font-size: larger;">{{obj.likes}}</span>
                  </div>
                  <div class="ms-auto">
                     <a href="" style="font-size: x-large; text-decoration: none; color: black;">@{{obj.username}}</a>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>

   <script src="/js/display-blogs.js"></script>